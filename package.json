{
  "name": "sign-pdf",
  "private": true,
  "version": "1.0.0",
  "description": "Sign a PDF in your browser. No account, no upload.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "assets": "node scripts/copy-pdfjs-assets.mjs",
    "predev": "npm run assets",
    "dev": "vite",
    "prebuild": "npm run assets",
    "build": "tsc && vite build",
    "preview": "node scripts/serve-subpath.mjs 4317 sign-pdf",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@fontsource/caveat": "5.3.0",
    "@fontsource/dancing-script": "5.3.0",
    "@fontsource/great-vibes": "5.3.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
